      h1 {
        text-align: center;
        font-size: 2rem;
        font-weight: 500;
        margin-bottom: 60px;
      }

      .content {
        font-size: 1.05rem;
      }

    .content p {
        margin: 0;
        text-indent: 2em;
    }

    .section-break {
        height: 2rem;
    }

      .back {
        display: block;
        margin-bottom: 50px;
        color: #666;
        text-decoration: none;
        font-size: 0.9rem;
      }

      .back:hover {
        color: #111;
      }

