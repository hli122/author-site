---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const chapters = await getCollection("jiaozhan");

  return chapters.map((chapter) => ({
    params: { slug: chapter.id },
    props: { chapter },
  }));
}

const { chapter } = Astro.props;
const { Content } = await render(chapter);

const chapters = await getCollection("jiaozhan");
chapters.sort((a, b) => a.data.order - b.data.order);

const currentIndex = chapters.findIndex(
  (item) => item.id === chapter.id
);

const previousChapter = chapters[currentIndex - 1];
const nextChapter = chapters[currentIndex + 1];
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={chapter.data.description || "《教战初集》"}
    />
    <title>{chapter.data.title} — 《教战初集》</title>
  </head>

  <body>
    <main>
      <header class="site-header">
        <a href="/jiaozhan/">《教战初集》</a>
      </header>

      <article>
        <header class="chapter-header">
          <p class="book-title">《教战初集》</p>
          <h1>{chapter.data.title}</h1>
        </header>

        <div class="content">
          <Content />
        </div>

        <nav class="chapter-nav">
          {
            previousChapter ? (
              <a href={`/jiaozhan/${previousChapter.id}/`}>
                ← {previousChapter.data.title}
              </a>
            ) : (
              <span></span>
            )
          }

          <a href="/jiaozhan/">目录</a>

          {
            nextChapter ? (
              <a href={`/jiaozhan/${nextChapter.id}/`}>
                {nextChapter.data.title} →
              </a>
            ) : (
              <span></span>
            )
          }
        </nav>
      </article>

      <footer>
        <p>《教战初集》</p>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #fafafa;
    color: #222;
    font-family:
      Georgia,
      "Times New Roman",
      "Noto Serif SC",
      "Songti SC",
      serif;
  }

  main {
    min-height: 100vh;
  }

  .site-header {
    max-width: 820px;
    margin: 0 auto;
    padding: 28px 24px;
    border-bottom: 1px solid #ddd;
  }

  .site-header a {
    color: #222;
    text-decoration: none;
    font-size: 16px;
  }

  article {
    max-width: 760px;
    margin: 0 auto;
    padding: 70px 24px 100px;
  }

  .chapter-header {
    margin-bottom: 55px;
    text-align: center;
  }

  .book-title {
    margin: 0 0 18px;
    color: #777;
    font-size: 14px;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    font-size: 32px;
    font-weight: 500;
    line-height: 1.4;
  }

  .content {
    font-size: 18px;
    line-height: 2;
  }

  .content :global(p) {
    margin: 0 0 1.4em;
  }

  .content :global(h1),
  .content :global(h2),
  .content :global(h3) {
    margin-top: 2.5em;
    margin-bottom: 1em;
    font-weight: 500;
    line-height: 1.5;
  }

  .content :global(h1) {
    font-size: 27px;
  }

  .content :global(h2) {
    font-size: 23px;
  }

  .content :global(h3) {
    font-size: 20px;
  }

  .content :global(blockquote) {
    margin: 2em 0;
    padding-left: 1.2em;
    border-left: 2px solid #ccc;
    color: #666;
  }

  .content :global(a) {
    color: inherit;
  }

  .chapter-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    margin-top: 80px;
    padding-top: 25px;
    border-top: 1px solid #ddd;
    font-size: 14px;
  }

  .chapter-nav a {
    color: #555;
    text-decoration: none;
  }

  .chapter-nav a:hover {
    text-decoration: underline;
  }

  .chapter-nav a:last-child {
    text-align: right;
  }

  footer {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px 40px;
    color: #999;
    font-size: 13px;
    text-align: center;
  }

  @media (max-width: 600px) {
    article {
      padding-top: 45px;
    }

    h1 {
      font-size: 27px;
    }

    .content {
      font-size: 17px;
      line-height: 1.9;
    }

    .chapter-nav {
      grid-template-columns: 1fr 1fr;
    }

    .chapter-nav a:nth-child(2) {
      grid-column: 1 / -1;
      grid-row: 1;
      text-align: center;
    }

    .chapter-nav a:last-child {
      text-align: right;
    }
  }
</style>